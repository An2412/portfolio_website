# Copy to .env.local and fill in the values from your Supabase project.
# Both names work; prefer the new publishable key when available.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Legacy naming, still supported as a fallback:
# VITE_SUPABASE_ANON_KEY=your-anon-key
